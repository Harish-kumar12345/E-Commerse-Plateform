# ==========================================
# NEXUS MARKETPLACE — ENVIRONMENT VARIABLES
# ==========================================

NODE_ENV=development
PORT=4000

# DATABASE (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/nexus_marketplace?schema=public"

# REDIS (Sessions, Queues, Rate Limiting)
REDIS_URL="redis://localhost:6379"

# MEILISEARCH (Instant Search Engine)
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_MASTER_KEY="nexus_master_meilisearch_key_2026"

# AUTHENTICATION (JWT & Cookies)
JWT_ACCESS_SECRET="nexus_super_secret_jwt_access_token_key_change_in_production_2026"
JWT_REFRESH_SECRET="nexus_super_secret_jwt_refresh_token_key_change_in_production_2026"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
COOKIE_SECRET="nexus_secure_cookie_secret_sign_key_98124"

# RAZORPAY PAYMENT GATEWAY (India INR)
RAZORPAY_KEY_ID="rzp_test_NexusSampleKeyId123"
RAZORPAY_KEY_SECRET="rzp_test_NexusSecretKey456"
RAZORPAY_WEBHOOK_SECRET="rzp_whsec_NexusWebhookSecret789"

# SHIPROCKET LOGISTICS API
SHIPROCKET_EMAIL="logistics@nexusmarket.in"
SHIPROCKET_PASSWORD="SampleShiprocketPassword123"

# EMAIL & NOTIFICATIONS
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="NEXUS Bazaar <no-reply@nexusmarket.in>"

# RESEND (Production Email)
RESEND_API_KEY="re_sample_test_key"

# CORS & FRONTEND URLS
STOREFRONT_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3001"
API_URL="http://localhost:4000"
